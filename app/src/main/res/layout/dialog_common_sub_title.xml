<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="dialog"
            type="com.example.thoughts_cleaning.util.dialog.recent.CommonDialog" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_common_sub_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="320dp"
        android:paddingVertical="25dp"
        android:background="@drawable/bg_dialog_common"
        app:layout_constraintWidth_percent="0.8888888888888889"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/dialog_common_sub_title_left_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.046875" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/dialog_common_sub_title_right_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.953125" />

        <TextView
            android:id="@+id/dialog_common_sub_title_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="3dp"
            android:gravity="center"
            android:text="@{dialog.title}"
            android:textSize="28dp"
            android:textColor="@color/black"
            android:fontFamily="@font/pretendard_semibold"
            app:layout_constraintStart_toEndOf="@id/dialog_common_sub_title_left_guide"
            app:layout_constraintEnd_toStartOf="@id/dialog_common_sub_title_right_guide"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/dialog_common_sub_title_title_sub_text"
            tools:text="제목"/>

        <TextView
            android:id="@+id/dialog_common_sub_title_title_sub_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="3dp"
            android:layout_marginVertical="15dp"
            android:gravity="center"
            android:text="@{dialog.titleSub}"
            android:textSize="20dp"
            android:textColor="#4098FF"
            android:fontFamily="@font/pretendard_semibold"
            app:layout_constraintStart_toEndOf="@id/dialog_common_sub_title_left_guide"
            app:layout_constraintEnd_toStartOf="@id/dialog_common_sub_title_right_guide"
            app:layout_constraintTop_toBottomOf="@id/dialog_common_sub_title_title_text"
            app:layout_constraintBottom_toTopOf="@id/dialog_common_sub_title_diver"
            tools:text="서브 제목"/>

        <View
            android:id="@+id/dialog_common_sub_title_diver"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#D1D1D1"
            app:layout_constraintStart_toEndOf="@id/dialog_common_sub_title_left_guide"
            app:layout_constraintEnd_toStartOf="@id/dialog_common_sub_title_right_guide"
            app:layout_constraintTop_toBottomOf="@id/dialog_common_sub_title_title_sub_text"
            app:layout_constraintBottom_toTopOf="@id/dialog_common_sub_title_main_text"/>

        <TextView
            android:id="@+id/dialog_common_sub_title_main_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="3dp"
            android:layout_marginVertical="15dp"
            android:gravity="center"
            android:text="@{dialog.main}"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:fontFamily="@font/pretendard_regular"
            app:layout_constraintStart_toEndOf="@id/dialog_common_sub_title_left_guide"
            app:layout_constraintEnd_toStartOf="@id/dialog_common_sub_title_right_guide"
            app:layout_constraintTop_toBottomOf="@id/dialog_common_sub_title_diver"
            app:layout_constraintBottom_toTopOf="@id/dialog_common_sub_title_bottom_layout"
            tools:text="본문 내용"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialog_common_sub_title_bottom_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/dialog_common_sub_title_left_guide"
            app:layout_constraintEnd_toEndOf="@id/dialog_common_sub_title_right_guide"
            app:layout_constraintTop_toBottomOf="@id/dialog_common_sub_title_main_text"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dialog_common_sub_title_bottom_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{dialog.cancelText}"
                android:textSize="24dp"
                android:textColor="@color/black"
                android:background="@drawable/button_dialog_common_cancel"
                android:onClick="@{() -> dialog.onCancelClick()}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/dialog_common_sub_title_bottom_space"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="@string/dialog_button_cancel"/>

            <View
                android:id="@+id/dialog_common_sub_title_bottom_space"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.03125"
                app:layout_constraintStart_toEndOf="@id/dialog_common_sub_title_bottom_cancel"
                app:layout_constraintEnd_toStartOf="@id/dialog_common_sub_title_bottom_confirm"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dialog_common_sub_title_bottom_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{dialog.confirmText}"
                android:textSize="24dp"
                android:textColor="@color/white"
                android:background="@drawable/button_dialog_common_confirm"
                android:onClick="@{() -> dialog.onConfirmClick()}"
                app:layout_constraintStart_toEndOf="@id/dialog_common_sub_title_bottom_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="@string/dialog_button_confirm"/>

        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>