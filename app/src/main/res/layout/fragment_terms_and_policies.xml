<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.example.thoughts_cleaning.views.main.TermsAndPoliciesEvent"/>
        <variable
                name="viewModel"
                type="com.example.thoughts_cleaning.views.main.vm.fragment.TermsAndPoliciesViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/terms_and_policies_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/basic_background"
            >

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_vertical_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_vertical_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.95" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_horizontal_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.03" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_horizontal_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.9" />


        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="@+id/guide_vertical_left"
                app:layout_constraintTop_toTopOf="@+id/guide_horizontal_top"
                app:layout_constraintEnd_toEndOf="@+id/guide_vertical_right"
                app:layout_constraintBottom_toTopOf="@+id/content_area"
                app:layout_constraintHeight_percent="0.08"
                >

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_back"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/btn_back"
                    android:scaleType="centerCrop"
                    android:stateListAnimator="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:onClick="@{() -> viewModel.onClick(TermsAndPoliciesEvent.BACK)}"
                    />


            <TextView
                    android:id="@+id/top_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="약관 및 정책"
                    android:gravity="center"
                    android:textSize="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/btn_back"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintVertical_bias="0.65" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guide_vertical_left"
            app:layout_constraintEnd_toEndOf="@+id/guide_vertical_right"
            app:layout_constraintTop_toBottomOf="@+id/top_area"
            android:paddingStart="25dp"
            >


        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/setting_app_info_privacy_detail_service_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

            <TextView
                    android:id="@+id/setting_app_info_privacy_detail_service_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center_vertical"
                    android:text="@string/setting_app_info_privacy_detail_service"
                    android:textSize="20dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/pretendard_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/setting_app_info_privacy_detail_service_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

<!--            <ImageButton-->
<!--                    android:id="@+id/setting_app_info_privacy_detail_service_button"-->
<!--                    android:contentDescription="setting_notification_next_button"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="0dp"-->
<!--                    android:src="@drawable/ic_arrow2"-->
<!--                    android:background="@android:color/transparent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent" />-->

            <ImageView
                    android:id="@+id/setting_app_info_privacy_detail_service_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_arrow2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:onClick="@{()-> viewModel.onClick(TermsAndPoliciesEvent.TERMS_OF_SERVICE)}"
                    />

            <!--            android:onClick="@{() -> viewModel.getUserTermList(TermType.SERVICE)}"-->

        </androidx.constraintlayout.widget.ConstraintLayout>



        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/setting_app_info_privacy_detail_personal_info_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/setting_app_info_privacy_detail_service_layout"
                >

            <TextView
                    android:id="@+id/setting_app_info_privacy_detail_personal_info_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center_vertical"
                    android:text="@string/setting_app_info_privacy_detail_personal_info"
                    android:textSize="20dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/pretendard_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/setting_app_info_privacy_detail_personal_info_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

<!--            <ImageButton-->
<!--                    android:id="@+id/setting_app_info_privacy_detail_personal_info_button"-->
<!--                    android:contentDescription="setting_notification_next_button"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="0dp"-->
<!--                    android:src="@drawable/ic_arrow2"-->
<!--                    android:background="@android:color/transparent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent"/>-->

            <ImageView
                    android:id="@+id/setting_app_info_privacy_detail_personal_info_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_arrow2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:onClick="@{()-> viewModel.onClick(TermsAndPoliciesEvent.PRIVACY_POLICY)}"
                    />

            <!--             android:onClick="@{() -> viewModel.getUserTermList(TermType.PRIVACY)}"-->


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/setting_app_info_privacy_detail_personal_location_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/setting_app_info_privacy_detail_personal_info_layout"
                >
            <!--            app:layout_constraintHeight_percent="0.2"-->

            <TextView
                    android:id="@+id/setting_app_info_privacy_detail_personal_location_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center_vertical"
                    android:text="@string/setting_app_info_privacy_detail_personal_location"
                    android:textSize="20dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/pretendard_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/setting_app_info_privacy_detail_personal_location_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

<!--            <ImageButton-->
<!--                    android:id="@+id/setting_app_info_privacy_detail_personal_location_button"-->
<!--                    android:contentDescription="setting_notification_next_button"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="0dp"-->
<!--                    android:src="@drawable/ic_arrow2"-->
<!--                    android:background="@android:color/transparent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent"/>-->

            <ImageView
                    android:id="@+id/setting_app_info_privacy_detail_personal_location_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_arrow2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:onClick="@{()-> viewModel.onClick(TermsAndPoliciesEvent.CONTACT_US)}"
                    />
            <!--            android:onClick="@{() -> viewModel.getUserTermList(TermType.LOCATION)}"-->


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>